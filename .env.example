# ─────────────────────────────────────────────────────────────────────────────
# kaiban-distributed-examples — environment template
# Copy to `.env` and fill in the keys for the example(s) you want to run.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (choose ONE) ────────────────────────────────────────────────
# Standard OpenAI:
OPENAI_API_KEY=
# …or any OpenAI-compatible endpoint (Ollama/vLLM/LM Studio). The base URL is read only
# together with OPENAI_API_KEY, so set that key to any non-empty value (e.g. ollama):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# …or OpenRouter (takes priority over OPENAI_API_KEY when set):
# OPENROUTER_API_KEY=
# Model id (default gpt-4o-mini; for OpenRouter use e.g. openai/gpt-4o-mini):
LLM_MODEL=gpt-4o-mini

# ── Agent tools (@kaibanjs/tools) — only needed by the examples that use them ─
# Trip Planning / Company Research (web search). Set the one matching your tool:
TAVILY_API_KEY=
SERPER_API_KEY=
# RAG Knowledge Base needs an OpenAI key specifically for embeddings,
# even if your chat LLM is OpenRouter/local. It reuses OPENAI_API_KEY above,
# or set a dedicated embeddings key here:
# RAG_OPENAI_API_KEY=

# ── Messaging / infrastructure ───────────────────────────────────────────────
MESSAGING_DRIVER=bullmq          # bullmq (Redis, default) | kafka
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092     # only for MESSAGING_DRIVER=kafka

# ── Gateway (board + A2A + health) ───────────────────────────────────────────
GATEWAY_URL=http://localhost:3000
VALID_HITL_DECISIONS=PUBLISH,REVISE,REJECT

# ── Workflow spend guard (the literal `unlimited` removes a cap; 0 does not) ─
MAX_WORKFLOW_COST_USD=0.50
MAX_WORKFLOW_TOKENS=unlimited

# ── Emergency STOP ALL ───────────────────────────────────────────────────────
# true or 1 turns it on; set it for the gateway, every worker AND the orchestrator
# (the compose files pass it to every service). Off by default.
CONTROL_PLANE_ENABLED=
# Gateway: secret that signs board tokens. Without it the board's STOP ALL button is
# refused; with it the board needs a token even to connect. Open the viewer as
# viewer/board.html#token=<board token> (how to create one: README, "Emergency STOP ALL").
BOARD_JWT_SECRET=
# Signs the stop command and the saved stop marker; same value on every service (the compose
# files pass it). With NODE_ENV=production it must differ from the two other secrets.
CHANNEL_SIGNING_SECRET=
# Before exposing the gateway beyond localhost (the compose files pass these to every gateway):
# DEPLOYMENT.md, "Before exposing the gateway". Unset = local defaults.
A2A_JWT_SECRET=
SOCKET_CORS_ORIGINS=
NODE_ENV=
# Behind a proxy or load balancer: true, and the gateway's public URL (default http://localhost:3000).
TRUST_PROXY=
A2A_PUBLIC_URL=http://localhost:3000

# ── Per-agent token caps (workers; defaults 200000 and 50000; `unlimited` removes a cap) ─
# A breach dead-letters the task. Empty = the default.
MAX_TOKEN_BUDGET=
MAX_TASK_TOKEN_BUDGET=

# ── Checkpoint key of the orchestrator (default: prefix + hash of the run inputs) ─
# A re-run with the same value resumes. Example inputs and timeouts: each example's README.
WORKFLOW_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# 1 = no anonymous KaibanJS telemetry (needed where nom.telemetrydeck.com is blocked).
KAIBAN_TELEMETRY_OPT_OUT=
